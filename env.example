# SciTrans Configuration
# Copy this file to .env and fill in your API keys
# NEVER commit .env to git (it's in .gitignore)

# Anthropic (Claude) - Production recommended
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI (GPT models)
OPENAI_API_KEY=sk-proj-...
# Optional: Custom OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (local models)
OLLAMA_API_KEY=optional-key-if-needed
# Optional: Custom Ollama endpoint
# OLLAMA_BASE_URL=http://localhost:11434

# HuggingFace (optional, for some models)
# HUGGINGFACE_API_KEY=hf_...

# Google Translate (optional, usually works without key)
# GOOGLE_TRANSLATE_API_KEY=...

# Optional: Custom paths
# SCITRANS_OUTPUT_DIR=./outputs
# SCITRANS_CACHE_DIR=./outputs/.cache
# SCITRANS_ASSETS_DIR=./scitrans/assets

