logger = logging.getLogger(__name__)

# Global state for logs
SYSTEM_LOGS = []
TRANSLATION_STATUS = []

# Common languages
COMMON_LANGUAGES = [
    ("English", "en"),
    ("French", "fr"),
    ("Spanish", "es"),
    ("German", "de"),
    ("Chinese", "zh"),
    ("Japanese", "ja"),
    ("Korean", "ko"),
    ("Portuguese", "pt"),
    ("Italian", "it"),
    ("Russian", "ru"),
    ("Arabic", "ar"),
    ("Dutch", "nl"),
]

# Backend to model mappings
BACKEND_MODELS = {
    "cascade_free": ["cascade_free"],
    "deepseek": ["deepseek-chat", "deepseek-reasoner"],
    "anthropic": ["claude-3-5-sonnet-20241022", "claude-3-opus-20240229", "claude-3-sonnet-20240229"],
    "openai": ["gpt-4o", "gpt-4-turbo", "gpt-3.5-turbo"],
    "google": ["gemini-pro", "gemini-1.5-flash"],
    "huggingface": ["meta-llama/Llama-2-70b-chat-hf", "mistralai/Mixtral-8x7B-Instruct-v0.1"],
    "ollama": ["llama2", "mistral", "codellama"],
    "dummy": ["dummy"],
}

def add_log(message: str, level: str = "INFO"):
    """Add a log entry."""
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    log_entry = f"[{timestamp}] [{level}] {message}"
    SYSTEM_LOGS.append(log_entry)
    logger.info(message)
    return "\n".join(SYSTEM_LOGS[-100:])  # Keep last 100 logs

def add_status(message: str):
    """Add a translation status entry."""
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    status_entry = f"[{timestamp}] {message}"
    TRANSLATION_STATUS.append(status_entry)
    return "\n".join(TRANSLATION_STATUS[-50:])  # Keep last 50 statuses

def get_models_for_backend(backend: str) -> list[str]:
    """Get available models for a backend."""
    return BACKEND_MODELS.get(backend, [backend])

def apply_preset(preset: str) -> tuple:
    """Apply configuration preset and return settings."""
    presets = {
        "balanced": {
            "candidates": 3,
            "context": 2,
            "temperature": 0.0,
            "cache": True,
            "reranking": True,
            "tables": False,
            "min_quality": 0.7,
            "auto_retry": True
        },
        "quality": {
            "candidates": 5,
            "context": 3,
            "temperature": 0.0,
            "cache": True,
            "reranking": True,
            "tables": False,
            "min_quality": 0.85,
            "auto_retry": True
        },
        "fast": {
            "candidates": 1,
            "context": 0,
            "temperature": 0.0,
            "cache": True,
            "reranking": False,
            "tables": False,
            "min_quality": 0.6,
            "auto_retry": False
        },
        "cost": {
            "candidates": 1,
            "context": 1,
            "temperature": 0.0,
            "cache": True,
            "reranking": False,
            "tables": False,
            "min_quality": 0.65,
            "auto_retry": False
        },
        "custom": {
            "candidates": 3,
            "context": 2,
            "temperature": 0.0,
            "cache": True,
            "reranking": True,
            "tables": False,
            "min_quality": 0.7,
            "auto_retry": True
        }
    }
    
    config = presets.get(preset, presets["balanced"])
    add_log(f"Applied preset: {preset}")
    
    return (
        config["candidates"],
        config["context"],
        config["temperature"],
        config["cache"],
        config["reranking"],
        config["tables"],
        config["min_quality"],
        config["auto_retry"]
    )

def estimate_cost(backend: str, model: str, num_pages: int = 10, candidates: int = 3) -> str:
    """Estimate translation cost."""
    # Cost estimates per 1K tokens (approximate)
    costs = {
        "cascade_free": 0.0,
        "dummy": 0.0,
        "google": 0.0,
        "deepseek": 0.001,  # $0.001 per 1K tokens (very cheap)
        "anthropic": 0.015,  # Claude Sonnet pricing
        "openai": 0.01,     # GPT-4o pricing
        "huggingface": 0.002,
        "ollama": 0.0
    }
    
    # Rough estimate: ~500 tokens per page
    estimated_tokens = num_pages * 500 * candidates
    cost_per_1k = costs.get(backend, 0.01)
    estimated_cost = (estimated_tokens / 1000) * cost_per_1k
    
    if estimated_cost == 0:
        return f"$0.00 ({backend} is free)"
    else:
        return f"${estimated_cost:.3f} for ~{num_pages} pages ({candidates} candidates)"

def save_config_profile(profile_name: str, config: dict) -> str:
    """Save current configuration as a profile."""
    if not profile_name:
        return "❌ Please enter a profile name"
    
    profiles_file = Path("config_profiles.json")
    
    try:
        if profiles_file.exists():
            profiles = json.loads(profiles_file.read_text())
        else:
            profiles = {}
        
        profiles[profile_name] = config
        profiles_file.write_text(json.dumps(profiles, indent=2))
        
        add_log(f"Saved configuration profile: {profile_name}")
        return f"✅ Saved profile: {profile_name}"
    except Exception as e:
        return f"❌ Error saving profile: {e}"

def load_config_profile(profile_name: str) -> tuple:
    """Load configuration profile."""
    if not profile_name:
        return (3, 2, 0.0, True, True, False, 0.7, True, "❌ Please enter a profile name")
    
    profiles_file = Path("config_profiles.json")
    
    try:
        if not profiles_file.exists():
            return (3, 2, 0.0, True, True, False, 0.7, True, "❌ No profiles found")
        
        profiles = json.loads(profiles_file.read_text())
        
        if profile_name not in profiles:
            available = ", ".join(profiles.keys())
            return (3, 2, 0.0, True, True, False, 0.7, True, f"❌ Profile not found. Available: {available}")
        
        config = profiles[profile_name]
        add_log(f"Loaded configuration profile: {profile_name}")
        
        return (
            config.get("candidates", 3),
            config.get("context", 2),
            config.get("temperature", 0.0),
            config.get("cache", True),
            config.get("reranking", True),
            config.get("tables", False),
            config.get("min_quality", 0.7),
            config.get("auto_retry", True),
            f"✅ Loaded profile: {profile_name}"
        )
    except Exception as e:
        return (3, 2, 0.0, True, True, False, 0.7, True, f"❌ Error loading profile: {e}")

def fetch_pdf_from_url(url: str) -> tuple[str | None, str]:
    """Fetch a PDF from a URL."""
    if not requests:
        return None, "❌ requests library not installed. Install with: pip install requests"
    
    try:
        add_log(f"Fetching PDF from URL: {url}")
        response = requests.get(url, timeout=30)
        response.raise_for_status()
        
        # Save to temporary file
        temp_path = Path("temp_downloaded.pdf")
        temp_path.write_bytes(response.content)
        
        add_log(f"✅ Successfully downloaded PDF ({len(response.content)} bytes)")
        return str(temp_path), f"✅ Downloaded PDF from {url}"
    except Exception as e:
        add_log(f"Failed to fetch PDF: {e}", "ERROR")
        return None, f"❌ Error: {str(e)}"

def render_pdf_page(pdf_path: str | None, page_num: int = 0) -> tuple[Any, int]:
    """Render a PDF page as an image."""
    if not pdf_path or not Path(pdf_path).exists():
        return None, 0
    
    if not fitz:
        return None, 0
    
    try:
        doc = fitz.open(pdf_path)
        total_pages = len(doc)
        
        if page_num < 0:
            page_num = 0
        if page_num >= total_pages:
            page_num = total_pages - 1
        
        page = doc.load_page(page_num)
        pix = page.get_pixmap(matrix=fitz.Matrix(2, 2))  # 2x zoom for better quality
        img_data = pix.tobytes("png")
        
        from PIL import Image
        img = Image.open(io.BytesIO(img_data))
        doc.close()
        
        return img, total_pages
    except Exception as e:
        add_log(f"Error rendering PDF page: {e}", "ERROR")
        return None, 0

def translate_pdf(
    pdf_file,
    pdf_url: str,
    backend: str,
    model: str,
    source: str,
    target: str,
    n_candidates: int,
    context_window: int,
    temperature: float,
    use_cache: bool,
    enable_reranking: bool,
    translate_tables: bool,
):
    """Translate a PDF file."""
    add_status("🚀 Starting translation process...")
    
    # Determine input source
    input_path = None
    if pdf_url and pdf_url.strip():
        add_status(f"📥 Fetching PDF from URL: {pdf_url}")
        input_path, msg = fetch_pdf_from_url(pdf_url.strip())
        if not input_path:
            add_status(f"❌ Failed to fetch PDF")
            return None, None, msg, "", ""
    elif pdf_file is not None:
        input_path = Path(pdf_file.name)
        add_status(f"📄 Using uploaded PDF: {input_path.name}")
    else:
        return None, None, "❌ Please upload a PDF file or provide a URL.", "", ""

    try:
        output_path = Path(input_path).with_stem(f"{Path(input_path).stem}_{target}")
        
        add_status(f"🔧 Configuring backend: {backend} ({model})")
        be = _get_backend(backend, model)

        add_status(f"⚙️ Pipeline config: {n_candidates} candidates, context={context_window}")
        cfg = PipelineConfig(
            source_lang=source,
            target_lang=target,
            model=model,
            temperature=temperature,
            n_candidates=n_candidates,
            context_window=context_window,
            use_cache=use_cache,
            enable_reranking=enable_reranking,
            translate_tables=translate_tables,
        )

        add_status("🔄 Running translation pipeline...")
        report = run_pipeline(
            input_pdf=str(input_path), output_pdf=str(output_path), backend=be, cfg=cfg
        )

        # Format report
        summary = f"""✅ Translation Complete!

**Input:** {Path(input_path).name}
**Output:** {output_path.name}
**Backend:** {backend} ({model})
**Blocks:** {report['num_blocks']} total, {report['num_ok']} OK, {report['num_failed']} failed
**Quality:** {report['scoring']['document_quality']:.1%}
**Time:** {report['elapsed_s']:.2f}s
**Health:** {report['health']['health_ratio']:.1%} blocks healthy
"""

        # Generate quality metrics visualization
        quality_metrics = generate_quality_metrics(report)
        
        add_status("✅ Translation completed successfully!")
        add_log(f"Translation complete: {input_path} -> {output_path}")
        
        # Render first page of output
        output_preview, _ = render_pdf_page(str(output_path), 0)
        
        return str(output_path), output_preview, summary, quality_metrics, get_status_log()

    except Exception as e:
        error_msg = f"❌ Error: {str(e)}"
        add_status(error_msg)
        add_log(f"Translation error: {e}", "ERROR")
        return None, None, error_msg, "", get_status_log()

def generate_quality_metrics(report: dict) -> str:
    """Generate quality metrics display."""
    scoring = report.get('scoring', {})
    health = report.get('health', {})
    
    metrics = f"""## 📊 Quality Metrics

### Overall Scores
- **Document Quality:** {scoring.get('document_quality', 0):.1%}
- **Average Score:** {scoring.get('avg_score', 0):.3f}
- **Health Ratio:** {health.get('health_ratio', 0):.1%}

### Block Statistics
- **Total Blocks:** {report.get('num_blocks', 0)}
- **Successful:** {report.get('num_ok', 0)}
- **Failed:** {report.get('num_failed', 0)}

### Dimension Breakdown
"""
    
    dimensions = scoring.get('dimensions', {})
    if dimensions:
        for dim, score in dimensions.items():
            metrics += f"- **{dim.replace('_', ' ').title()}:** {score:.1%}\n"
    
    return metrics

def get_status_log() -> str:
    """Get the current status log."""
    return "\n".join(TRANSLATION_STATUS[-50:])

def get_system_log() -> str:
    """Get the current system log."""
    return "\n".join(SYSTEM_LOGS[-100:])

def run_all_tests():
    """Run the full test suite."""
    add_log("Running full test suite...")
    try:
        result = subprocess.run(
            ["python3", "-m", "pytest", "tests/", "-v", "--tb=short"],
            capture_output=True,
            text=True,
            timeout=180,
        )
        output = f"Exit code: {result.returncode}\n\n{result.stdout}\n\n{result.stderr}"
        add_log(f"Tests completed with exit code {result.returncode}")
        return output
    except Exception as e:
        error = f"❌ Error running tests: {e}"
        add_log(error, "ERROR")
        return error

def run_individual_test(test_name: str):
    """Run an individual test file."""
    add_log(f"Running test: {test_name}")
    try:
        result = subprocess.run(
            ["python3", "-m", "pytest", f"tests/{test_name}", "-v"],
            capture_output=True,
            text=True,
            timeout=60,
        )
        output = f"Exit code: {result.returncode}\n\n{result.stdout}"
        add_log(f"Test {test_name} completed with exit code {result.returncode}")
        return output
    except Exception as e:
        error = f"❌ Error: {e}"
        add_log(error, "ERROR")
        return error

def run_ablation_study(
    pdf_file,
    ablation_type: str,
    baseline_config: dict,
    test_config: dict,
):
    """Run ablation study with visualization."""
    if pdf_file is None:
        return None, "Please upload a PDF file first."
    
    add_log(f"Running ablation study: {ablation_type}")
    
    # Placeholder - would run actual experiments
    results = {
        'baseline': {'quality': 0.85, 'time': 12.5, 'cost': 0.05},
        'test': {'quality': 0.92, 'time': 15.3, 'cost': 0.08}
    }
    
    # Generate visualization
    plot_path = generate_ablation_plot(ablation_type, results)
    
    summary = f"""🔬 Ablation Study: {ablation_type}

**PDF:** {Path(pdf_file.name).name}

### Baseline Configuration
{json.dumps(baseline_config, indent=2)}

### Test Configuration
{json.dumps(test_config, indent=2)}

### Results
- **Quality Improvement:** {(results['test']['quality'] - results['baseline']['quality']) * 100:.1f}%
- **Time Overhead:** {results['test']['time'] - results['baseline']['time']:.1f}s
- **Cost Difference:** ${results['test']['cost'] - results['baseline']['cost']:.3f}

*Note: Run full experiments via CLI: `make experiments`*
"""
    
    return plot_path, summary

def generate_ablation_plot(ablation_type: str, results: dict) -> str | None:
    """Generate ablation study visualization."""
    if not plt:
        return None
    
    try:
        fig, axes = plt.subplots(1, 3, figsize=(15, 4))
        
        configs = ['Baseline', 'Test']
        metrics = ['quality', 'time', 'cost']
        titles = ['Quality Score', 'Time (s)', 'Cost ($)']
        
        for i, (metric, title) in enumerate(zip(metrics, titles)):
            values = [results['baseline'][metric], results['test'][metric]]
            axes[i].bar(configs, values, color=['#4b6cb7', '#182848'])
            axes[i].set_title(title)
            axes[i].set_ylabel(title)
            
            # Add value labels
            for j, v in enumerate(values):
                axes[i].text(j, v, f'{v:.2f}', ha='center', va='bottom')
        
        plt.suptitle(f'Ablation Study: {ablation_type}', fontsize=14, fontweight='bold')
        plt.tight_layout()
        
        # Save plot
        plot_path = Path("temp_ablation_plot.png")
        plt.savefig(plot_path, dpi=150, bbox_inches='tight')
        plt.close()
        
        return str(plot_path)
    except Exception as e:
        add_log(f"Error generating plot: {e}", "ERROR")
        return None

def load_glossary() -> dict:
    """Load glossary from file."""
    glossary_path = Path("glossary.json")
    if not glossary_path.exists():
        return {}
    try:
        return json.loads(glossary_path.read_text())
    except Exception:
        return {}

def save_glossary(source: str, target: str, current_glossary: dict) -> tuple[dict, str]:
    """Add a term to the glossary."""
    if not source or not target:
        return current_glossary, "❌ Both source and target terms are required."
    
    current_glossary[source.strip()] = target.strip()
    
    try:
        glossary_path = Path("glossary.json")
        glossary_path.write_text(json.dumps(current_glossary, indent=2, ensure_ascii=False))
        add_log(f"Added glossary term: {source} -> {target}")
        return current_glossary, f"✅ Added term to glossary ({len(current_glossary)} terms total)"
    except Exception as e:
        return current_glossary, f"❌ Error: {e}"

def delete_glossary_term(term: str, current_glossary: dict) -> tuple[dict, str]:
    """Delete a term from the glossary."""
    if term in current_glossary:
        del current_glossary[term]
        glossary_path = Path("glossary.json")
        glossary_path.write_text(json.dumps(current_glossary, indent=2, ensure_ascii=False))
        add_log(f"Deleted glossary term: {term}")
        return current_glossary, f"✅ Deleted term from glossary"
    return current_glossary, "❌ Term not found"

def search_glossary(query: str, glossary: dict) -> str:
    """Search glossary terms."""
    if not query:
        return format_glossary_table(glossary)
    
    filtered = {k: v for k, v in glossary.items() if query.lower() in k.lower() or query.lower() in v.lower()}
    return format_glossary_table(filtered)

def format_glossary_table(glossary: dict) -> str:
    """Format glossary as a table."""
    if not glossary:
        return "No terms in glossary."
    
    table = "| Source Term | Target Term |\n|-------------|-------------|\n"
    for source, target in sorted(glossary.items()):
        table += f"| {source} | {target} |\n"
    
    return table

def export_glossary() -> str:
    """Export glossary to file."""
    glossary = load_glossary()
    export_path = Path("glossary_export.txt")
    
    lines = [f"{source}: {target}" for source, target in glossary.items()]
    export_path.write_text("\n".join(lines), encoding="utf-8")
    
    return str(export_path)

def import_glossary_file(file) -> tuple[dict, str]:
    """Import glossary from uploaded file."""
    if file is None:
        return load_glossary(), "❌ No file uploaded."
    
    try:
        content = Path(file.name).read_text(encoding="utf-8")
        glossary = load_glossary()
        
        for line in content.strip().split("\n"):
            if ":" in line:
                source, target = line.split(":", 1)
                glossary[source.strip()] = target.strip()
        
        glossary_path = Path("glossary.json")
        glossary_path.write_text(json.dumps(glossary, indent=2, ensure_ascii=False))
        
        add_log(f"Imported glossary from {Path(file.name).name}")
        return glossary, f"✅ Imported {len(glossary)} terms"
    except Exception as e:
        return load_glossary(), f"❌ Error: {e}"

def save_api_key(backend: str, api_key: str) -> str:
    """Save API key to environment file."""
    if not api_key:
        return "❌ API key cannot be empty."
    
    env_file = Path("setup_env.sh")
    
    # Read existing content
    if env_file.exists():
        content = env_file.read_text()
    else:
        content = "#!/bin/bash\n# API Keys for SciTrans\n\n"
    
    # Update or add the key
    key_name = f"{backend.upper()}_API_KEY"
    key_line = f'export {key_name}="{api_key}"\n'
    
    if key_name in content:
        # Replace existing
        lines = content.split("\n")
        for i, line in enumerate(lines):
            if line.startswith(f"export {key_name}="):
                lines[i] = key_line.strip()
        content = "\n".join(lines)
    else:
        # Add new
        content += key_line
    
    env_file.write_text(content)
    
    # Also set in current environment
    os.environ[key_name] = api_key
    
    add_log(f"Saved API key for {backend}")
    return f"✅ API key saved for {backend}. Please restart the GUI to apply changes."

def get_backend_status() -> str:
    """Get status of all backends."""
    backends = ["deepseek", "anthropic", "openai", "google", "huggingface"]
    
    table = "| Backend | Status | Models Available |\n|---------|--------|------------------|\n"
    
    for backend in backends:
        key_name = f"{backend.upper()}_API_KEY"
        status = "✅ Configured" if os.getenv(key_name) else "❌ Not Set"
        models = ", ".join(BACKEND_MODELS.get(backend, [])[:3])
        table += f"| {backend} | {status} | {models} |\n"
    
    # Add free backends
    table += "| cascade_free | ✅ Always Available | cascade_free |\n"
    table += "| dummy | ✅ Always Available | dummy |\n"
    table += "| ollama | ⚙️ Requires Local Setup | llama2, mistral |\n"
    
    return table

def create_gui():
    """Create and launch the enhanced Gradio GUI."""

    # Custom CSS
    custom_css = """
    .gradio-container {
        font-family: 'Inter', sans-serif;
        max-width: 1400px !important;
    }
    .gr-button-primary {
        background: linear-gradient(90deg, #4b6cb7 0%, #182848 100%);
    }
    .metric-box {
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 15px;
        margin: 10px 0;
    }
    """
    
    with gr.Blocks(title="SciTrans-LLMs Enhanced", css=custom_css, theme=gr.themes.Soft()) as app:
        gr.Markdown("""
        # 🌍 SciTrans-LLMs — Enhanced GUI
        ## Adaptive Scientific Document Translation with LLMs
        **Franck Davy | Wenzhou University | 2025**
        """)

        with gr.Tabs():
            # ===== TAB 1: TRANSLATION =====
            with gr.Tab("📄 Translation"):
                gr.Markdown("### Translate Scientific PDFs with Advanced Options")

                with gr.Row():
                    with gr.Column(scale=1):
                        gr.Markdown("#### 📥 Input Source")
                        pdf_input = gr.File(label="Upload PDF", file_types=[".pdf"])
                        gr.Markdown("**OR**")
                        pdf_url_input = gr.Textbox(
                            label="Fetch from URL",
                            placeholder="https://example.com/paper.pdf"
                        )
                        
                        gr.Markdown("#### 🔧 Configuration")
                        
                        backend_dropdown = gr.Dropdown(
                            choices=list(BACKEND_MODELS.keys()),
                            value="cascade_free",
                            label="Backend",
                            info="Select the translation backend"
                        )
                        
                        model_dropdown = gr.Dropdown(
                            choices=BACKEND_MODELS["cascade_free"],
                            value="cascade_free",
                            label="Model",
                            info="Specific model to use (auto-populated based on backend)"
                        )

                        with gr.Row():
                            source_lang_dropdown = gr.Dropdown(
                                choices=[(name, code) for name, code in COMMON_LANGUAGES],
                                value="en",
                                label="Source Language"
                            )
                            target_lang_dropdown = gr.Dropdown(
                                choices=[(name, code) for name, code in COMMON_LANGUAGES],
                                value="fr",
                                label="Target Language"
                            )
                    
                    with gr.Column(scale=1):
                        gr.Markdown("#### 🎯 Configuration Presets")
                        preset_choice = gr.Radio(
                            choices=[
                                ("⚖️ Balanced (Recommended)", "balanced"),
                                ("🏆 Maximum Quality", "quality"),
                                ("⚡ Fast Mode", "fast"),
                                ("💰 Cost Optimized", "cost"),
                                ("🔧 Custom", "custom")
                            ],
                            value="balanced",
                            label="Select Preset",
                            info="Quick configurations for common scenarios"
                        )
                        
                        gr.Markdown("#### ⚙️ Advanced Settings")
                        n_candidates = gr.Slider(1, 5, value=3, step=1, label="Translation Candidates")
                        context_window = gr.Slider(0, 5, value=2, step=1, label="Context Window Size")
                        temperature = gr.Slider(0.0, 1.0, value=0.0, step=0.1, label="Temperature")

                        with gr.Row():
                            use_cache = gr.Checkbox(value=True, label="Enable Cache")
                        enable_reranking = gr.Checkbox(value=True, label="Enable Reranking")
                        translate_tables = gr.Checkbox(value=False, label="Translate Tables")

                        gr.Markdown("#### 📊 Quality Control")
                        min_quality = gr.Slider(
                            0.5, 1.0, value=0.7, step=0.05,
                            label="Minimum Quality Threshold",
                            info="Auto-retry blocks below this score"
                        )
                        auto_retry = gr.Checkbox(value=True, label="Auto-Retry Failed Blocks")
                        
                        gr.Markdown("#### 💾 Configuration Profiles")
                with gr.Row():
                            profile_name = gr.Textbox(
                                label="Profile Name",
                                placeholder="My Thesis Settings",
                                scale=2
                            )
                            save_profile_btn = gr.Button("💾 Save", scale=1, size="sm")
                            load_profile_btn = gr.Button("📂 Load", scale=1, size="sm")
                        
                        profile_status = gr.Textbox(label="Profile Status", lines=1, max_lines=1)
                        
                        gr.Markdown("#### 💰 Cost Estimation")
                        cost_estimate = gr.Textbox(
                            label="Estimated Cost",
                            value="$0.00 (cascade_free is free)",
                            interactive=False
                        )
                
                translate_btn = gr.Button("🚀 Start Translation", variant="primary", size="lg")

                with gr.Row():
                    with gr.Column():
                        gr.Markdown("#### 📊 Results & Preview")
                        with gr.Tabs():
                            with gr.Tab("📄 Translated PDF Preview"):
                                output_preview = gr.Image(label="Preview", type="pil")
                                output_file = gr.File(label="Download Translated PDF")
                            
                            with gr.Tab("📈 Quality Metrics"):
                                quality_metrics_display = gr.Markdown("*Translation metrics will appear here*")
                            
                            with gr.Tab("ℹ️ Translation Summary"):
                                translation_summary = gr.Textbox(label="Summary", lines=12)
                    
                    with gr.Column():
                        gr.Markdown("#### 📋 Status & Logs")
                        with gr.Tabs():
                            with gr.Tab("📊 Translation Status"):
                                status_log = gr.Textbox(label="Status", lines=20, max_lines=20)
                            
                            with gr.Tab("🖥️ System Logs"):
                                system_log = gr.Textbox(label="System Log", lines=20, max_lines=20)
                
                # Auto-update model dropdown when backend changes
                def update_models(backend):
                    models = get_models_for_backend(backend)
                    return gr.Dropdown(choices=models, value=models[0])
                
                backend_dropdown.change(
                    update_models,
                    inputs=[backend_dropdown],
                    outputs=[model_dropdown]
                )
                
                # Apply preset configuration
                def preset_handler(preset):
                    if preset == "custom":
                        return  # Don't change settings for custom
                    settings = apply_preset(preset)
                    return settings
                
                preset_choice.change(
                    preset_handler,
                    inputs=[preset_choice],
                    outputs=[n_candidates, context_window, temperature, use_cache, enable_reranking, translate_tables, min_quality, auto_retry]
                )
                
                # Update cost estimate when backend or candidates change
                def update_cost(backend, model, candidates):
                    return estimate_cost(backend, model, 10, candidates)
                
                for component in [backend_dropdown, model_dropdown, n_candidates]:
                    component.change(
                        update_cost,
                        inputs=[backend_dropdown, model_dropdown, n_candidates],
                        outputs=[cost_estimate]
                    )
                
                # Save configuration profile
                def save_profile_handler(name, candidates, context, temp, cache, rerank, tables, min_q, retry):
                    config = {
                        "candidates": candidates,
                        "context": context,
                        "temperature": temp,
                        "cache": cache,
                        "reranking": rerank,
                        "tables": tables,
                        "min_quality": min_q,
                        "auto_retry": retry
                    }
                    return save_config_profile(name, config)
                
                save_profile_btn.click(
                    save_profile_handler,
                    inputs=[profile_name, n_candidates, context_window, temperature, use_cache, enable_reranking, translate_tables, min_quality, auto_retry],
                    outputs=[profile_status]
                )
                
                # Load configuration profile
                def load_profile_handler(name):
                    return load_config_profile(name)
                
                load_profile_btn.click(
                    load_profile_handler,
                    inputs=[profile_name],
                    outputs=[n_candidates, context_window, temperature, use_cache, enable_reranking, translate_tables, min_quality, auto_retry, profile_status]
                )
                
                # Translation handler
                translate_btn.click(
                    translate_pdf,
                    inputs=[
                        pdf_input, pdf_url_input, backend_dropdown, model_dropdown,
                        source_lang_dropdown, target_lang_dropdown,
                        n_candidates, context_window, temperature,
                        use_cache, enable_reranking, translate_tables
                    ],
                    outputs=[output_file, output_preview, translation_summary, quality_metrics_display, status_log]
                )
            
            # ===== TAB 2: TESTING =====
            with gr.Tab("🧪 Testing"):
                gr.Markdown("""### Comprehensive System Testing
                Test individual features or run the complete test suite to ensure everything works correctly.""")
                
                with gr.Row():
                    with gr.Column():
                        gr.Markdown("#### Run All Tests")
                        test_all_btn = gr.Button("🚀 Run Complete Test Suite", variant="primary")
                        
                        gr.Markdown("#### Individual Feature Tests")
                        test_dropdown = gr.Dropdown(
                            choices=[
                                "test_adaptive_scoring.py",
                                "test_backends.py",
                                "test_caching.py",
                                "test_health_scoring.py",
                                "test_integration.py",
                                "test_layout_intelligence.py",
                                "test_mask_roundtrip.py",
                                "test_math_detection.py",
                                "test_math_rendering.py",
                                "test_reranking.py",
                                "test_table_detection.py",
                            ],
                            label="Select Test Module"
                        )
                        test_individual_btn = gr.Button("Run Selected Test", variant="secondary")
                    
                    with gr.Column():
                        test_output = gr.Textbox(label="Test Results", lines=25, max_lines=30)
                
                test_all_btn.click(run_all_tests, inputs=[], outputs=[test_output])
                test_individual_btn.click(
                    run_individual_test,
                    inputs=[test_dropdown],
                    outputs=[test_output]
                )
            
            # ===== TAB 3: ABLATIONS =====
            with gr.Tab("🔬 Ablations"):
                gr.Markdown("""### Ablation Studies with Visualizations
                
                Compare different configurations to measure the impact of each feature:
                - **Reranking Impact**: Effect of multi-candidate reranking
                - **Context Window**: Impact of surrounding context
                - **Backend Comparison**: Compare different LLM backends
                - **Cache Effect**: Measure caching benefits
                """)

                with gr.Row():
                    with gr.Column():
                        ablation_pdf = gr.File(label="Upload Test PDF", file_types=[".pdf"])
                        
                    ablation_type = gr.Dropdown(
                        choices=[
                            "Reranking Impact",
                                "Context Window Size",
                            "Backend Comparison",
                            "Cache Effect",
                                "Temperature Sensitivity",
                        ],
                        value="Backend Comparison",
                            label="Ablation Study Type"
                    )

                        gr.Markdown("#### Baseline Configuration")
                    baseline_backend = gr.Dropdown(
                            choices=list(BACKEND_MODELS.keys()),
                        value="dummy",
                            label="Baseline Backend"
                    )
                        baseline_rerank = gr.Checkbox(value=False, label="Use Reranking")
                        
                        gr.Markdown("#### Test Configuration")
                    test_backend = gr.Dropdown(
                            choices=list(BACKEND_MODELS.keys()),
                        value="cascade_free",
                            label="Test Backend"
                        )
                        test_rerank = gr.Checkbox(value=True, label="Use Reranking")
                        
                        ablation_btn = gr.Button("🔬 Run Ablation Study", variant="primary")
                    
                    with gr.Column():
                        ablation_plot = gr.Image(label="Results Visualization", type="filepath")
                        ablation_results = gr.Markdown("*Results will appear here*")
                
                def run_ablation_wrapper(pdf, abl_type, bb, br, tb, tr):
                    baseline_cfg = {'backend': bb, 'reranking': br}
                    test_cfg = {'backend': tb, 'reranking': tr}
                    return run_ablation_study(pdf, abl_type, baseline_cfg, test_cfg)

                ablation_btn.click(
                    run_ablation_wrapper,
                    inputs=[ablation_pdf, ablation_type, baseline_backend, baseline_rerank, test_backend, test_rerank],
                    outputs=[ablation_plot, ablation_results]
                )
            
            # ===== TAB 4: GLOSSARY =====
            with gr.Tab("📚 Glossary"):
                gr.Markdown("""### Manage Translation Glossary
                
                Define domain-specific terms to ensure consistent translation across documents.
                Search, add, import, and export glossary terms.""")
                
                glossary_state = gr.State(load_glossary())
                
                with gr.Row():
                    with gr.Column(scale=1):
                        gr.Markdown("#### 🔍 Search & Browse")
                        search_box = gr.Textbox(label="Search Terms", placeholder="Type to search...")
                        glossary_table = gr.Markdown(format_glossary_table(load_glossary()))
                        
                        gr.Markdown("#### ➕ Add New Term")
                        with gr.Row():
                            new_source = gr.Textbox(label="Source Term", placeholder="neural network")
                            new_target = gr.Textbox(label="Target Term", placeholder="réseau neuronal")
                        add_term_btn = gr.Button("Add Term", variant="primary")
                        glossary_status = gr.Textbox(label="Status", lines=2)
                    
                    with gr.Column(scale=1):
                        gr.Markdown("#### 📥 Import / Export")
                        
                        export_btn = gr.Button("📤 Export Glossary", variant="secondary")
                        export_file = gr.File(label="Exported Glossary")
                        
                        gr.Markdown("---")
                        
                        import_file = gr.File(label="📥 Import Glossary File", file_types=[".txt", ".json"])
                        import_btn = gr.Button("Import from File", variant="secondary")
                        
                        gr.Markdown("""
                        #### 🌐 Download Public Glossaries
                        
                        *Feature coming soon: Download glossaries from*
                        - Europarl (EU Parliament translations)
                        - IATE (EU terminology database)
                        - Custom online sources
                        """)
                        
                        download_europarl_btn = gr.Button("Download Europarl Glossary (Coming Soon)", variant="secondary", interactive=False)
                
                # Search functionality
                def search_handler(query, glossary):
                    return search_glossary(query, glossary)
                
                search_box.change(
                    search_handler,
                    inputs=[search_box, glossary_state],
                    outputs=[glossary_table]
                )
                
                # Add term
                def add_term_handler(source, target, glossary):
                    new_glossary, msg = save_glossary(source, target, glossary)
                    return new_glossary, format_glossary_table(new_glossary), msg, "", ""
                
                add_term_btn.click(
                    add_term_handler,
                    inputs=[new_source, new_target, glossary_state],
                    outputs=[glossary_state, glossary_table, glossary_status, new_source, new_target]
                )
                
                # Export
                export_btn.click(
                    export_glossary,
                    inputs=[],
                    outputs=[export_file]
                )
                
                # Import
                def import_handler(file, glossary):
                    new_glossary, msg = import_glossary_file(file)
                    return new_glossary, format_glossary_table(new_glossary), msg
                
                import_btn.click(
                    import_handler,
                    inputs=[import_file, glossary_state],
                    outputs=[glossary_state, glossary_table, glossary_status]
                )
            
            # ===== TAB 5: SETTINGS =====
            with gr.Tab("⚙️ Settings"):
                gr.Markdown("""### System Settings & Configuration
                
                Configure API keys, view backend status, and customize system preferences.""")
                
                with gr.Row():
                    with gr.Column():
                        gr.Markdown("#### 🔑 API Key Management")
                        
                        backend_for_key = gr.Dropdown(
                            choices=["deepseek", "anthropic", "openai", "google", "huggingface"],
                            label="Select Backend"
                        )
                        api_key_input = gr.Textbox(
                            label="API Key",
                            placeholder="sk-...",
                            type="password"
                        )
                        save_key_btn = gr.Button("💾 Save API Key", variant="primary")
                        key_status = gr.Textbox(label="Status", lines=2)
                        
                        gr.Markdown("""
                        **Note:** API keys are saved to `setup_env.sh`. 
                        Restart the GUI after updating keys.
                        """)
                        
                        gr.Markdown("#### 🎨 Appearance")
                        gr.Markdown("*Dark mode toggle coming soon with Gradio 4.x*")
                        
                        gr.Markdown("#### 🔧 Default Settings")
                        default_backend = gr.Dropdown(
                            choices=list(BACKEND_MODELS.keys()),
                            value="cascade_free",
                            label="Default Backend"
                        )
                        default_candidates = gr.Slider(1, 5, value=3, step=1, label="Default Candidates")
                        save_defaults_btn = gr.Button("Save Defaults", variant="secondary", interactive=False)
                        
                    with gr.Column():
                        gr.Markdown("#### 📊 Backend Status")
                        backend_status_table = gr.Markdown(get_backend_status())
                        refresh_status_btn = gr.Button("🔄 Refresh Status")
                        
                        gr.Markdown("#### ℹ️ System Information")
                        gr.Markdown(f"""
                        - **Version:** {__version__}
                        - **Python:** {subprocess.run(['python3', '--version'], capture_output=True, text=True).stdout.strip()}
                        - **Gradio:** {gr.__version__}
                        """)
                
                save_key_btn.click(
                    save_api_key,
                    inputs=[backend_for_key, api_key_input],
                    outputs=[key_status]
                )
                
                refresh_status_btn.click(
                    get_backend_status,
                    inputs=[],
                    outputs=[backend_status_table]
                )
            
            # ===== TAB 6: ABOUT =====
            with gr.Tab("ℹ️ About"):
                gr.Markdown(f"""
                # SciTrans-LLMs System Information
                
                **Version:** {__version__}  
                **Author:** Franck Davy  
                **Institution:** Wenzhou University  
                **Thesis:** Adaptive Document Translation Enhanced by Technology based on LLMs  
                **Year:** 2025
                
                ## 🎯 Research Contributions
                
                This system implements 5 novel contributions:
                
                1. **Adaptive Translation Strategy** — Pre-scoring drives parameter adaptation
                2. **Multi-Dimensional Scoring** — 5-dimensional quality assessment
                3. **Repair-Driven Workflow** — Selective block repair (10× efficiency)
                4. **Cascade-Free Backend** — Ensemble + reranking at $0 cost
                5. **Integrated Scoring Pipeline** — End-to-end QA system
                
                ## ✨ Features
                
                - ✅ Multi-column layout preservation
                - ✅ Math-safe translation (equations protected)
                - ✅ Table-safe handling
                - ✅ Context-aware translation
                - ✅ Multi-candidate reranking
                - ✅ Automatic quality scoring
                - ✅ Selective repair workflow
                - ✅ Translation caching
                - ✅ URL fetching support
                - ✅ PDF preview with pagination
                - ✅ Interactive quality metrics
                - ✅ Comprehensive testing suite
                - ✅ Ablation study visualizations
                - ✅ Advanced glossary management
                
                ## 🔧 Available Backends
                
                | Backend | Type | Cost | Quality |
                |---------|------|------|---------|
                | cascade_free | Ensemble | Free | ⭐⭐⭐⭐⭐ |
                | deepseek | API | Free Tier | ⭐⭐⭐⭐⭐ |
                | anthropic | API | Paid | ⭐⭐⭐⭐⭐ |
                | openai | API | Paid | ⭐⭐⭐⭐ |
                | google | API | Free | ⭐⭐⭐ |
                | huggingface | API | Free Tier | ⭐⭐⭐ |
                | ollama | Local | Free | ⭐⭐⭐ |
                | dummy | Test | Free | ⭐ |
                
                ## 📚 Documentation
                
                - `README.md` - Complete system documentation
                - `docs/` - Technical documentation
                - `THESIS_RESEARCH.md` - Research contributions
                - `QUICK_START.md` - Quick start guide
                
                ## 🚀 Quick Start
                
                1. Upload a PDF or provide a URL in the Translation tab
                2. Select backend (cascade_free recommended for free, high-quality results)
                3. Configure source/target languages
                4. Click "Start Translation" and download the result
                5. Review quality metrics and preview
                
                ## 📧 Contact
                
                **Email:** aknk.v@pm.me  
                **Institution:** Wenzhou University, 2025
                
                ## 📄 Citation
                
                ```bibtex
                @mastersthesis{{davy2025scitrans,
                  title={{Adaptive Document Translation Enhanced by Technology based on LLMs}},
                  author={{Davy, Franck}},
                  year={{2025}},
                  school={{Wenzhou University}}
                }}
                ```
                """)

    return app


def launch_gui(share: bool = False, server_port: int = 7860):
    """Launch the enhanced SciTrans GUI."""
    add_log("Starting SciTrans-LLMs Enhanced GUI...")
    add_log(f"Version: {__version__}")
    add_log(f"Server port: {server_port}")
    
    app = create_gui()
    app.launch(share=share, server_port=server_port, show_error=True)


if __name__ == "__main__":
    launch_gui()
